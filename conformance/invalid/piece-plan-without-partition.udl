{
  "instruments": [
    {
      "actionOrder": [
        "create",
        "fund_piece",
        "payout_piece"
      ],
      "actions": {
        "create": {
          "moves": [],
          "steps": [],
          "summary": "Create watch instrument"
        },
        "fund_piece": {
          "calls": [
            {
              "action": "transfers.execute_fund",
              "bind": {
                "inst": "$instance",
                "p": "$piece"
              },
              "id": "call_fund"
            }
          ],
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "fund_piece.call_fund.leaf_fund"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "pieceId": {
                "enum": [
                  "p1",
                  "p2"
                ],
                "type": "string"
              }
            },
            "required": [
              "pieceId"
            ],
            "type": "object"
          },
          "moves": [],
          "pieceStage": {
            "plan": "split_plan",
            "stage": "fund"
          },
          "steps": [],
          "summary": "Fund one piece in stage"
        },
        "payout_piece": {
          "calls": [
            {
              "action": "transfers.execute_release",
              "bind": {
                "inst": "$instance",
                "p": "$piece"
              },
              "id": "call_rel"
            }
          ],
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "payout_piece.call_rel.leaf_rel"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "pieceId": {
                "enum": [
                  "p1",
                  "p2"
                ],
                "type": "string"
              }
            },
            "required": [
              "pieceId"
            ],
            "type": "object"
          },
          "moves": [],
          "pieceStage": {
            "plan": "split_plan",
            "stage": "release"
          },
          "steps": [],
          "summary": "Release piece"
        }
      },
      "actionLibrary": {
        "transfers": {
          "actionOrder": [
            "execute_fund",
            "execute_release"
          ],
          "actions": {
            "execute_fund": {
              "approval": "inherit",
              "calls": [],
              "leaves": [
                {
                  "bind": {
                    "amount": "$p.amount",
                    "destinationAccountId": "$p.release_to",
                    "sourceAccountId": "$inst.fields.buyerAccount"
                  },
                  "effects": [
                    {
                      "kind": "moves",
                      "signature": "moves.transfer.internal"
                    }
                  ],
                  "evidence": "bank transfer confirmation receipt",
                  "id": "leaf_fund",
                  "operation": "internal_transfer.create"
                }
              ],
              "order": [
                "leaf_fund"
              ],
              "parameters": {
                "inst": {
                  "kind": "instance"
                },
                "p": {
                  "kind": "piece"
                }
              },
              "principal": "api_key",
              "recovery": "local"
            },
            "execute_release": {
              "approval": "inherit",
              "calls": [],
              "leaves": [
                {
                  "bind": {
                    "amount": "$p.amount",
                    "destinationAccountId": "$p.release_to",
                    "sourceAccountId": "$inst.fields.escrowAccount"
                  },
                  "effects": [
                    {
                      "kind": "moves",
                      "signature": "moves.transfer.internal"
                    }
                  ],
                  "evidence": "release to payee confirmation",
                  "id": "leaf_rel",
                  "operation": "internal_transfer.create"
                }
              ],
              "order": [
                "leaf_rel"
              ],
              "parameters": {
                "inst": {
                  "kind": "instance"
                },
                "p": {
                  "kind": "piece"
                }
              },
              "principal": "api_key",
              "recovery": "local"
            }
          }
        }
      },
      "fields": {
        "buyerAccount": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "currency": {
          "const": "USD",
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "escrowAccount": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "p1Amount": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "USD"
        },
        "p1Refund": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "p1Release": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "p2Amount": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "USD"
        },
        "p2Refund": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "p2Release": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "totalAmount": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "USD"
        }
      },
      "id": "escrow_watch",
      "idPrefix": "ew",
      "lifecycle": {
        "initial": "draft",
        "states": [
          "draft",
          "funded",
          "released"
        ],
        "transitions": {
          "fund_piece": {
            "from": [
              "draft"
            ],
            "to": "funded"
          },
          "payout_piece": {
            "from": [
              "funded"
            ],
            "to": "released"
          }
        }
      },
      "piecePlan": {
        "fund_order": [
          "p1",
          "p2"
        ],
        "id": "split_plan",
        "pieces": [
          {
            "amount": "p1Amount",
            "id": "p1",
            "refund_to": "p1Refund",
            "release_to": "p1Release"
          },
          {
            "amount": "p2Amount",
            "id": "p2",
            "refund_to": "p2Refund",
            "release_to": "p2Release"
          }
        ],
        "refund_order": [
          "p1"
        ],
        "release_order": [
          "p1",
          "p2"
        ],
        "total": "totalAmount",
        "unfund_order": [
          "p2",
          "p1"
        ]
      },
      "required": [
        "totalAmount",
        "p1Amount",
        "p2Amount",
        "p1Release",
        "p1Refund",
        "p2Release",
        "p2Refund",
        "buyerAccount",
        "escrowAccount"
      ],
      "summary": "Escrow watch contract with piece plan",
      "title": "Escrow Watch"
    }
  ],
  "product": "escrow_watch",
  "subjects": [],
  "title": "Escrow Watch Document",
  "udl": 1,
  "version": 1
}
