            ]
          }
        },
        "sellerPays": {
          "description": "Side B amount in SAR minor units, held against the whole trade",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "sellerTradeFee": {
          "description": "Immutable exact seller service fee in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
