{
  "instruments": [
    {
      "actionOrder": [
        "create",
        "pay_piece_1",
        "pay_piece_2",
        "collect_service_fee"
      ],
      "actions": {
        "collect_service_fee": {
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.checkoutFee"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.platformAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "purchase"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "collect_service_fee"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.memberAccountId"
                }
              },
              "capture": {
                "collectServiceFeeTransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "collectServiceFeePurchase",
          "steps": [],
          "summary": "Collect the payer-side service fee"
        },
        "create": {
          "moves": [],
          "publicAction": "createPurchase",
          "steps": [],
          "summary": "Create a purchase payment"
        },
        "pay_piece_1": {
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.netOfCarvedFeeAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.sellerAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "purchase"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "pay_piece_1"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.memberAccountId"
                }
              },
              "capture": {
                "payPiece1TransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "payPiece1Purchase",
          "steps": [],
          "summary": "Pay piece 1 of the amount through"
        },
        "pay_piece_2": {
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.carvedFeeAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.platformAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "purchase"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "pay_piece_2"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.memberAccountId"
                }
              },
              "capture": {
                "payPiece2TransferTransferId": "transferId"
              },
              "key": "transfer",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "payPiece2Purchase",
          "steps": [],
          "summary": "Pay piece 2 of the amount through"
        }
      },
      "description": "Instant transfer: the member pays purchasePrice straight through to the seller, no custody",
      "feeRules": [
        {
          "amountField": "checkoutFee",
          "baseField": "purchasePrice",
          "bearerField": "memberAccountId",
          "position": "on_top",
          "rule": {
            "currencyField": "currency",
            "field": "checkoutFee",
            "kind": "exact"
          }
        },
        {
          "amountField": "carvedFeeAmount",
          "baseField": "purchasePrice",
          "bearerField": "sellerAccountId",
          "position": "carved",
          "rule": {
            "kind": "tiered",
            "tiers": [
              {
                "fromInclusive": "0",
                "rule": {
                  "bps": 100,
                  "kind": "bps"
                },
                "toExclusive": "10000"
              },
              {
                "fromInclusive": "10000",
                "rule": {
                  "currencyField": "currency",
                  "field": "highValueFee",
                  "kind": "exact"
                }
              }
            ]
          }
        }
      ],
      "fields": {
        "carvedFeeAmount": {
          "description": "The carved platform fee selected from purchasePrice",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "checkoutFee": {
          "description": "Immutable exact member fee in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "highValueFee": {
          "description": "Immutable exact seller fee in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "memberAccountId": {
          "description": "The member account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "netOfCarvedFeeAmount": {
          "description": "The remainder of purchasePrice after the carved platform fee",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "platformAccountId": {
          "description": "The product fee collection account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-fee-collection-port": true,
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance",
              "product_revenue"
            ]
          }
        },
        "purchasePrice": {
          "description": "The gross amount in SAR minor units; the piece fields below partition it exactly",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "sellerAccountId": {
          "description": "The seller account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        }
      },
      "id": "purchase",
      "idPrefix": "purc",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "paying_1",
          "paying_2",
          "paid"
        ],
        "transitions": {
          "collect_service_fee": {
            "from": [
              "paying_2"
            ],
            "to": "paid"
          },
          "pay_piece_1": {
            "from": [
              "created"
            ],
            "to": "paying_1"
          },
          "pay_piece_2": {
            "from": [
              "paying_1"
            ],
            "to": "paying_2"
          }
        }
      },
      "parties": {
        "beneficiary": "sellerAccountId",
        "payer": "memberAccountId"
      },
      "partitions": [
        {
          "pieceFields": [
            "netOfCarvedFeeAmount",
            "carvedFeeAmount"
          ],
          "totalField": "purchasePrice"
        }
      ],
      "required": [
        "memberAccountId",
        "sellerAccountId",
        "platformAccountId",
        "purchasePrice",
        "netOfCarvedFeeAmount",
        "checkoutFee",
        "highValueFee",
        "currency"
      ],
      "summary": "Instant payment from member to seller",
      "title": "Purchase"
    },
    {
      "actionOrder": [
        "create",
        "place_deposit",
        "assess_watch",
        "return_deposit"
      ],
      "actions": {
        "assess_watch": {
          "decidedAmount": {
            "boundField": "depositAmount",
            "field": "damageAmount",
            "remainderAction": "return_deposit"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.tenant_port",
                "source": "port"
              }
            ],
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              },
              {
                "signature": "moves.transfer.internal",
                "source": "moves[1]"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "damageAmount": {
                "description": "Caller-decided amount in minor units",
                "pattern": "^(0|[1-9][0-9]{0,17})$",
                "type": "string"
              },
              "evidence": {
                "description": "Required decision reference retained in the operation receipt",
                "maxLength": 180,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "damageAmount",
              "evidence"
            ],
            "type": "object"
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "input",
                  "path": "damageAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "postMode": {
                  "from": "const",
                  "value": "partial_only"
                },
                "transferId": {
                  "from": "instance",
                  "path": "refs.placeDepositReservationTransferId"
                }
              },
              "key": "post",
              "operation": "internal_transfer.post"
            },
            {
              "bind": {
                "reason": {
                  "from": "const",
                  "value": "Return the unclaimed deposit remainder"
                },
                "transferId": {
                  "from": "instance",
                  "path": "refs.placeDepositReservationTransferId"
                }
              },
              "key": "remainder",
              "operation": "internal_transfer.void"
            }
          ],
          "port": {
            "allowedParties": [
              "beneficiary"
            ]
          },
          "publicAction": "assessWatchInspectionDeposit",
          "steps": [],
          "summary": "Claim the deposit for the seller through assess_watch"
        },
        "create": {
          "moves": [],
          "publicAction": "createInspectionDeposit",
          "steps": [],
          "summary": "Create a inspection deposit"
        },
        "place_deposit": {
          "effects": {
            "holds": [
              {
                "signature": "holds.reserve",
                "source": "moves[0]"
              }
            ],
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.depositAmount"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.sellerAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "inspection_deposit"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "place_deposit"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.memberAccountId"
                }
              },
              "capture": {
                "placeDepositReservationTransferId": "transferId"
              },
              "key": "reservation",
              "operation": "internal_transfer.reserve"
            }
          ],
          "publicAction": "placeDepositInspectionDeposit",
          "steps": [],
          "summary": "Reserve the depositAmount against the member's account"
        },
        "return_deposit": {
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "reason": {
                  "from": "const",
                  "value": "Deposit returned in full"
                },
                "transferId": {
                  "from": "instance",
                  "path": "refs.placeDepositReservationTransferId"
                }
              },
              "key": "void",
              "operation": "internal_transfer.void"
            }
          ],
          "publicAction": "returnDepositInspectionDeposit",
          "steps": [],
          "summary": "Return the deposit to the member through return_deposit"
        }
      },
      "description": "Deposit: the depositAmount is reserved against the member's account in the seller's favor, then damageAmount is claimed and the exact remainder returned, or the deposit is returned in full",
      "fields": {
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "depositAmount": {
          "description": "The deposit amount in SAR minor units, reserved in full and fully accounted on claim or return",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "memberAccountId": {
          "description": "The member account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "sellerAccountId": {
          "description": "The seller account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        }
      },
      "id": "inspection_deposit",
      "idPrefix": "id",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "held",
          "claimed",
          "returned"
        ],
        "transitions": {
          "assess_watch": {
            "from": [
              "held"
            ],
            "to": "claimed"
          },
          "place_deposit": {
            "from": [
              "created"
            ],
            "to": "held"
          },
          "return_deposit": {
            "from": [
              "held"
            ],
            "to": "returned"
          }
        }
      },
      "parties": {
        "beneficiary": "sellerAccountId",
        "payer": "memberAccountId"
      },
      "required": [
        "memberAccountId",
        "sellerAccountId",
        "depositAmount",
        "currency"
      ],
      "summary": "Refundable deposit from member held for seller",
      "title": "Inspection deposit"
    },
    {
      "actionOrder": [
        "create",
        "open_period",
        "collect_period",
        "cancel_membership"
      ],
      "actions": {
        "cancel_membership": {
          "captureInput": {
            "reason": "reason"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.tenant_port",
                "source": "port"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "reason": {
                "description": "Required decision reference retained in the operation receipt",
                "maxLength": 180,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "reason"
            ],
            "type": "object"
          },
          "moves": [],
          "port": {
            "allowedParties": [
              "payer"
            ]
          },
          "publicAction": "cancelMembershipMembership",
          "steps": [],
          "summary": "Cancel the open schedule and drain any period liability"
        },
        "collect_period": {
          "captureInput": {
            "mandateEvidenceReference": "evidenceReference"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.tenant_port",
                "source": "port"
              }
            ],
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "evidenceReference": {
                "description": "Required decision reference retained in the operation receipt",
                "maxLength": 180,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "evidenceReference"
            ],
            "type": "object"
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.monthlyFee"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.clubAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "membership"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "collect_period"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "fields.memberAccountId"
                }
              },
              "capture": {
                "collectPeriodPeriodCollectionTransferId": "transferId"
              },
              "key": "period_collection",
              "operation": "internal_transfer.create"
            }
          ],
          "port": {
            "allowedParties": [
              "payer"
            ]
          },
          "publicAction": "collectPeriodMembership",
          "steps": [],
          "summary": "Collect one authored period charge with mandate evidence"
        },
        "create": {
          "moves": [],
          "publicAction": "createMembership",
          "steps": [],
          "summary": "Create the open obligation before its first anchor"
        },
        "open_period": {
          "due": {
            "every": {
              "delinquency": "parent_policy",
              "drainAction": "cancel_membership",
              "liability": "one_open",
              "period": {
                "calendar": "gregorian",
                "monthEnd": "clamp_to_last_day",
                "months": 1
              },
              "untilAction": "cancel_membership"
            },
            "field": "firstPeriodAt"
          },
          "effects": {
            "schedules": [
              {
                "signature": "schedules.due",
                "source": "due"
              }
            ]
          },
          "moves": [],
          "steps": [],
          "summary": "Open exactly one period liability without moving money"
        }
      },
      "description": "Open monthly obligation for member; one period liability at a time",
      "fields": {
        "clubAccountId": {
          "description": "The club account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "currency": {
          "const": "SAR",
          "description": "ISO 4217 currency code",
          "type": "string"
        },
        "firstPeriodAt": {
          "description": "First period anchor; missing Gregorian month days clamp to the target month's final day",
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "memberAccountId": {
          "description": "The member account",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "monthlyFee": {
          "description": "Exact charge for one P1M period in SAR minor units",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        }
      },
      "id": "membership",
      "idPrefix": "memb",
      "lifecycle": {
        "initial": "active",
        "states": [
          "active",
          "period_open",
          "canceled"
        ],
        "transitions": {
          "cancel_membership": {
            "from": [
              "active",
              "period_open"
            ],
            "to": "canceled"
          },
          "collect_period": {
            "from": [
              "period_open"
            ],
            "to": "active"
          },
          "open_period": {
            "from": [
              "active"
            ],
            "to": "period_open"
          }
        }
      },
      "parties": {
        "beneficiary": "clubAccountId",
        "payer": "memberAccountId"
      },
      "required": [
        "memberAccountId",
        "clubAccountId",
        "monthlyFee",
        "currency",
        "firstPeriodAt"
      ],
      "summary": "Open P1M obligation for member",
      "title": "Membership"
    },
    {
      "actionOrder": [
        "abandon",
        "cancel",
        "create",
        "dispute",
        "fund",
        "post",
        "release"
      ],
      "actions": {
        "abandon": {
          "moves": [],
          "publicAction": "abandonMemberTrade",
          "requiresDrainedAccount": {
            "path": "refs.escrowAccountId"
          },
          "steps": [],
          "summary": "Abandon the trade before its atomic funding batch"
        },
        "cancel": {
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              },
              {
                "signature": "moves.transfer.internal",
                "source": "moves[1]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.memberPays"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.memberAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
                  "value": "member_trade"
                },
                "metadata.instrumentInstanceId": {
                  "from": "instance",
                  "path": "instrumentInstanceId"
                },
                "metadata.phase": {
                  "from": "const",
                  "value": "cancel"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.escrowAccountId"
                }
              },
              "capture": {
                "cancelSideARefundTransferId": "transferId"
              },
              "key": "side_a_refund",
              "operation": "internal_transfer.create"
            },
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.sellerPays"
                },
                "currency": {
                  "from": "instance",
                  "path": "fields.currency"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.sellerAccountId"
                },
                "metadata.instrumentId": {
                  "from": "const",
