{
  "instruments": [
    {
      "actionOrder": [
        "create",
        "approve",
        "consume"
      ],
      "actions": {
        "approve": {
          "agentDescription": "Record the bound deciding account.",
          "effects": {
            "decides": [
              {
                "signature": "decides.tenant_port",
                "source": "port"
              }
            ]
          },
          "moves": [],
          "port": {
            "allowedParties": [
              "decider"
            ],
            "capture": "decidedBy"
          },
          "steps": [],
          "summary": "Approve instrument"
        },
        "consume": {
          "agentDescription": "Consume this approval within the admitted operation.",
          "captureEngine": {
            "consumedByOperationId": "operationId"
          },
          "engineOwned": true,
          "moves": [],
          "steps": [],
          "summary": "Consume instrument"
        },
        "create": {
          "agentDescription": "Store the immutable request terms.",
          "moves": [],
          "requestAuthority": {
            "actionField": "actionName",
            "digestField": "digest",
            "expiresField": "expiry",
            "inputField": "requestInput",
            "instanceField": "requestId",
            "instrumentField": "requestInstrument",
            "party": "decider",
            "roleField": "role"
          },
          "steps": [],
          "summary": "Create instrument"
        }
      },
      "agentDescription": "Record approval for one exact request.",
      "fields": {
        "actionName": {
          "type": "string"
        },
        "decidedBy": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "deciderAccount": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "expiry": {
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "requestInput": {
          "additionalProperties": true,
          "type": "object"
        },
        "requestInstrument": {
          "type": "string"
        },
        "role": {
          "type": "string"
        }
      },
      "id": "approval",
      "idPrefix": "apr",
      "lifecycle": {
        "initial": "requested",
        "states": [
          "requested",
          "approved",
          "consumed"
        ],
        "transitions": {
          "approve": {
            "from": [
              "requested"
            ],
            "to": "approved"
          },
          "consume": {
            "from": [
              "approved"
            ],
            "to": "consumed"
          }
        }
      },
      "parties": {
        "decider": "deciderAccount"
      },
      "required": [
        "deciderAccount",
        "requestId",
        "requestInstrument",
        "actionName",
        "digest",
        "role",
        "expiry"
      ],
      "summary": "Approval instrument",
      "title": "Approval"
    },
    {
      "actionOrder": [
        "create",
        "accept"
      ],
      "actions": {
        "accept": {
          "agentDescription": "Accept the exact approved amount once.",
          "effects": {
            "decides": [
              {
                "signature": "decides.referenced_transition",
                "source": "transitionsRefs[0]"
              }
            ],
            "reads": [
              {
                "signature": "reads.requires_refs",
                "source": "requiresRefs"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "pattern": "^[1-9][0-9]{0,17}$",
                "type": "string",
                "x-hyperscale-currency": "SAR"
              }
            },
            "required": [
              "amount"
            ],
            "type": "object"
          },
          "moves": [],
          "requiresInput": {
            "amount": "fields.amount"
          },
          "requiresRefs": [
            {
              "attests": {
                "action": "fields.actionName",
                "consume": "consume",
                "digest": "fields.digest",
                "expiresAt": "fields.expiry",
                "instrument": "fields.requestInstrument",
                "party": "decider",
                "role": "fields.role"
              },
              "field": "approvalId",
              "match": {
                "instrumentInstanceId": "fields.requestId"
              },
              "statuses": [
                "approved"
              ]
            }
          ],
          "steps": [],
          "summary": "Accept instrument"
        },
        "create": {
          "agentDescription": "Store the immutable request terms.",
          "moves": [],
          "steps": [],
          "summary": "Create instrument"
        }
      },
      "agentDescription": "Admit only the independently approved request.",
      "fields": {
        "amount": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "approvalId": {
          "pattern": "^apr_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        }
      },
      "id": "request",
      "idPrefix": "req",
      "lifecycle": {
        "initial": "open",
        "states": [
          "open",
          "done"
        ],
        "transitions": {
          "accept": {
            "from": [
              "open"
            ],
            "to": "done"
          }
        }
      },
      "required": [
        "approvalId",
        "amount",
        "currency"
      ],
      "summary": "Request instrument",
      "title": "Request"
    }
  ],
  "product": "attested",
  "subjects": [],
  "title": "Attested action",
  "udl": 1,
  "version": 1
}
