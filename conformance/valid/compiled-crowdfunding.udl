        "payer": "servicingPoolAccountId"
      },
      "required": [
        "lenderAccountId",
        "servicingPoolAccountId",
        "currency",
        "repaymentDistributionId",
        "committedWeight"
      ],
      "summary": "Frozen entitlement in repayment_distribution",
      "title": "Repayment distribution Entitlement"
