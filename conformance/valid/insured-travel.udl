              "limitAmount",
              "deductibleBps",
              "waitingPeriodDays"
            ],
            "type": "object"
          },
          "maxItems": 24,
          "minItems": 1,
          "type": "array"
        },
        "policyholderAccountId": {
          "description": "Hyperscale account ID",
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string",
          "x-hyperscale-reference-filter": {
            "column": "role",
            "values": [
              "customer_balance"
            ]
          }
        },
        "premiumAmount": {
          "description": "Positive minor-unit integer amount serialized as a string (at most 18 digits)",
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string"
        },
        "renewalOfPolicyId": {
          "description": "Prior policy this quote renews; the prior term must be active or already expired",
          "pattern": "^pol_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "startsAt": {
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "termsSummary": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
        }
      },
      "id": "policy",
      "idPrefix": "pol",
      "lifecycle": {
        "initial": "quoted",
        "states": [
          "quoted",
          "bound",
          "active",
          "cancel_quoted",
          "canceled",
          "expired"
        ],
        "transitions": {
          "activate": {
            "from": [
              "bound"
            ],
            "to": "active"
          },
          "bind": {
            "from": [
              "quoted"
            ],
            "to": "bound"
          },
          "cancel": {
            "from": [
              "cancel_quoted"
            ],
