          },
          "endorse": {
            "from": [
              "active"
            ],
            "to": "active"
          },
          "expire": {
            "from": [
              "active"
            ],
            "to": "expired"
          },
          "preview": {
            "from": [
              "bound"
            ],
            "to": "cancel_quoted"
          },
          "withdraw": {
            "from": [
              "quoted"
            ],
            "to": "canceled"
          }
        }
