          ],
          "input": {
            "additionalProperties": false,
            "properties": {
              "amendmentNote": {
                "maxLength": 180,
                "minLength": 1,
                "type": "string"
              },
              "rateDifference": {
                "description": "Positive minor-unit integer amount serialized as a string (at most 18 digits)",
                "pattern": "^[1-9][0-9]{0,17}$",
                "type": "string"
              }
            },
            "required": [
              "rateDifference",
              "amendmentNote"
            ],
            "type": "object"
          },
          "moves": [
            {
              "bind": {
                "amount": {
