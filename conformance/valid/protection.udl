          "flight_itinerary",
          "lodging_stay",
          "vehicle",
          "merchandise",
          "pet",
          "traveler_party",
          "employee_census"
        ]
      },
      "summary": "Demand against active protection for one covered peril.",
      "templateId": "insurance",
      "title": "Claim",
      "update": {
        "examples": [
