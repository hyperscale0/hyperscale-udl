{
  "instruments": [
    {
      "actionOrder": [
        "payoff",
        "write_off",
        "create",
        "close"
      ],
      "actions": {
        "close": {
          "agentDescription": "Close when the declared count and schedule hold.",
          "cascade": [
            {
              "action": "close",
              "inputField": "sliceIds",
              "instrumentId": "slice"
            }
          ],
          "effects": {
            "decides": [
              {
                "signature": "decides.cascade_transition",
                "source": "cascade[0]"
              }
            ],
            "reads": [
              {
                "signature": "reads.requires_aggregate",
                "source": "requiresAggregate"
              }
            ]
          },
          "moves": [],
          "publicAction": "closeCover",
          "requiresAggregate": [
            {
              "check": {
                "kind": "count_at_least",
                "targetField": "minimumMissed"
              },
              "instrumentId": "slice",
              "over": "children",
              "refField": "coverId",
              "statuses": [
                "closed"
              ]
            },
            {
              "check": {
                "field": "dueAt",
                "kind": "ordered",
                "positionField": "position"
              },
              "instrumentId": "slice",
              "over": "children",
              "refField": "coverId",
              "statuses": [
                "open"
              ]
            },
            {
              "check": {
                "amounts": [
                  {
                    "amountField": "principal",
                    "totalField": "principal"
                  },
                  {
                    "amountField": "profit",
                    "totalField": "profit"
                  }
                ],
                "dateField": "dueAt",
                "datesField": "dates",
                "kind": "schedule",
                "positionField": "position",
                "remainder": "first"
              },
              "instrumentId": "slice",
              "over": "children",
              "refField": "coverId",
              "statuses": [
                "open"
              ]
            }
          ],
          "steps": [],
          "summary": "Close instrument"
        },
        "create": {
          "agentDescription": "Record the signed cover terms.",
          "moves": [],
          "publicAction": "createCover",
          "requiresExposure": [
            {
              "amountField": "principal",
              "anchorField": "limitId",
              "capField": "cap",
              "capOnAnchor": true,
              "childInstrumentId": "cover",
              "measure": {
                "allocation": "principal"
              },
              "statuses": [
                "open"
              ]
            }
          ],
          "steps": [],
          "summary": "Create instrument"
        },
        "payoff": {
          "agentDescription": "Compute this obligation's payoff from its remaining balances.",
          "allocate": {
            "capture": "payoffReceipt",
            "mode": "payoff",
            "paymentIdentityField": "paymentIdentity",
            "sourceAccountField": "payerAccount"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.allocation",
                "source": "allocate"
              }
            ],
            "moves": [
              {
                "signature": "moves.allocation",
                "source": "allocate"
              }
            ]
          },
          "input": {
            "additionalProperties": false,
            "properties": {
              "payerAccount": {
                "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
                "type": "string"
              },
              "paymentIdentity": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "payerAccount",
              "paymentIdentity"
            ],
            "type": "object"
          },
          "moves": [],
          "publicAction": "payoffCover",
          "steps": [],
          "summary": "Payoff instrument"
        },
        "write_off": {
          "agentDescription": "Cancel this obligation without cash.",
          "allocate": {
            "capture": "loss",
            "mode": "write_off"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.allocation",
                "source": "allocate"
              }
            ]
          },
          "moves": [],
          "publicAction": "writeOffCover",
          "steps": [],
          "summary": "Write Off instrument"
        }
      },
      "agentDescription": "Freeze the signed dates and amounts before admitting slices.",
      "allocation": {
        "buckets": [
          {
            "key": "principal",
            "source": {
              "amountField": "principal",
              "destinationField": "receiver",
              "from": "slice"
            }
          },
          {
            "key": "profit",
            "source": {
              "amountField": "profit",
              "destinationField": "receiver",
              "from": "slice"
            }
          },
          {
            "key": "cost",
            "source": {
              "amountField": "amount",
              "destinationField": "receiver",
              "from": "children",
              "parameters": {
                "cost": true
              },
              "refField": "sliceId",
              "statuses": [
                "open"
              ],
              "template": "assessment"
            }
          }
        ],
        "dueField": "dueAt",
        "earningRuleField": "earningRule",
        "positionField": "position",
        "sliceInstrumentId": "slice",
        "sliceRefField": "coverId",
        "sliceStatuses": [
          "open"
        ]
      },
      "dateOrder": [
        {
          "afterField": "end",
          "beforeField": "start",
          "operator": "<"
        }
      ],
      "fields": {
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "dates": {
          "items": {
            "format": "hyperscale-date-time",
            "type": "string"
          },
          "maxItems": 366,
          "minItems": 1,
          "type": "array"
        },
        "earningRule": {
          "enum": [
            "per_slice_on_due",
            "on_disbursement"
          ],
          "type": "string"
        },
        "end": {
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "limitId": {
          "pattern": "^lim_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "minimumMissed": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "principal": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "profit": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "start": {
          "format": "hyperscale-date-time",
          "type": "string"
        }
      },
      "id": "cover",
      "idPrefix": "cvr",
      "lifecycle": {
        "initial": "open",
        "states": [
          "open",
          "closed"
        ],
        "transitions": {
          "close": {
            "from": [
              "open"
            ],
            "to": "closed"
          },
          "payoff": {
            "from": [
              "open"
            ],
            "to": "closed"
          },
          "write_off": {
            "from": [
              "open"
            ],
            "to": "closed"
          }
        }
      },
      "required": [
        "limitId",
        "start",
        "end",
        "minimumMissed",
        "principal",
        "profit",
        "dates",
        "earningRule",
        "currency"
      ],
      "summary": "Cover instrument",
      "title": "Cover"
    },
    {
      "actionOrder": [
        "create",
        "close"
      ],
      "actions": {
        "close": {
          "due": {
            "field": "dueAt",
            "offset": {
              "field": "grace"
            }
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.allocation",
                "source": "requiresAllocation"
              },
              {
                "signature": "decides.referenced_transition",
                "source": "transitionsRefs[0]"
              }
            ],
            "schedules": [
              {
                "signature": "schedules.due",
                "source": "due"
              }
            ]
          },
          "moves": [],
          "requiresAllocation": {
            "buckets": [
              "principal",
              "profit"
            ],
            "check": "settled",
            "refField": "coverId",
            "slice": "self"
          },
          "steps": [],
          "summary": "Close instrument",
          "transitionsRefs": [
            {
              "action": "close",
              "field": "coverId"
            }
          ]
        },
        "create": {
          "agentDescription": "Check both signed bounds and the assessment kind.",
          "effects": {
            "reads": [
              {
                "signature": "reads.requires_refs",
                "source": "requiresRefs"
              }
            ]
          },
          "moves": [],
          "publicAction": "createSlice",
          "requiresRefs": [
            {
              "dateComparison": {
                "localPath": "fields.start",
                "operator": ">=",
                "referencedPath": "fields.start"
              },
              "field": "coverId",
              "statuses": [
                "open"
              ],
              "unique": {
                "byFields": [
                  "kind"
                ],
                "namespace": "assessment"
              }
            },
            {
              "dateComparison": {
                "localPath": "fields.end",
                "operator": "<=",
                "referencedPath": "fields.end"
              },
              "field": "coverId",
              "statuses": [
                "open"
              ]
            }
          ],
          "steps": [],
          "summary": "Create instrument"
        }
      },
      "agentDescription": "Keep one premium and its signed interval.",
      "derivedAmounts": [
        {
          "field": "commission",
          "rounding": "floor",
          "rule": {
            "bps": {
              "field": "rate"
            },
            "kind": "percentage_of"
          },
          "sourceField": "premium"
        },
        {
          "field": "charge",
          "rounding": "floor",
          "rule": {
            "capField": "cap",
            "kind": "minimum"
          },
          "sourceField": "cost"
        }
      ],
      "fields": {
        "cap": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "charge": {
          "pattern": "^(0|[1-9][0-9]{0,17})$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "commission": {
          "pattern": "^(0|[1-9][0-9]{0,17})$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "cost": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "coverId": {
          "pattern": "^cvr_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "dueAt": {
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "end": {
          "format": "hyperscale-date-time",
          "type": "string"
        },
        "grace": {
          "enum": [
            "P3D",
            "P7D"
          ],
          "type": "string"
        },
        "kind": {
          "enum": [
            "fine",
            "cost"
          ],
          "type": "string"
        },
        "position": {
          "maximum": 366,
          "minimum": 1,
          "type": "integer"
        },
        "premium": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "principal": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "profit": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "rate": {
          "maximum": 1000,
          "minimum": 500,
          "type": "integer"
        },
        "receiver": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "start": {
          "format": "hyperscale-date-time",
          "type": "string"
        }
      },
      "id": "slice",
      "idPrefix": "slc",
      "lifecycle": {
        "initial": "open",
        "states": [
          "open",
          "closed"
        ],
        "transitions": {
          "close": {
            "from": [
              "open"
            ],
            "to": "closed"
          }
        }
      },
      "required": [
        "coverId",
        "start",
        "end",
        "dueAt",
        "position",
        "principal",
        "profit",
        "premium",
        "cost",
        "cap",
        "rate",
        "grace",
        "kind",
        "receiver",
        "currency"
      ],
      "summary": "Slice instrument",
      "title": "Slice"
    },
    {
      "actionOrder": [
        "create",
        "close"
      ],
      "actions": {
        "close": {
          "agentDescription": "Close this claim.",
          "moves": [],
          "publicAction": "closeClaim",
          "steps": [],
          "summary": "Close coverId"
        },
        "create": {
          "agentDescription": "Read the cover's due premiums under the admission clock.",
          "effects": {
            "reads": [
              {
                "signature": "reads.requires_aggregate",
                "source": "requiresAggregate"
              }
            ]
          },
          "moves": [],
          "publicAction": "createClaim",
          "requiresAggregate": [
            {
              "anchorField": "coverId",
              "check": {
                "kind": "count_exactly",
                "value": 0
              },
              "dueBefore": {
                "field": "dueAt"
              },
              "instrumentId": "slice",
              "over": "siblings",
              "refField": "coverId",
              "statuses": [
                "open"
              ]
            }
          ],
          "steps": [],
          "summary": "Create coverId"
        }
      },
      "agentDescription": "Refuse a claim while a sibling premium is unpaid past due.",
      "fields": {
        "coverId": {
          "pattern": "^cvr_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        }
      },
      "id": "claim",
      "idPrefix": "clm",
      "lifecycle": {
        "initial": "open",
        "states": [
          "open",
          "closed"
        ],
        "transitions": {
          "close": {
            "from": [
              "open"
            ],
            "to": "closed"
          }
        }
      },
      "required": [
        "coverId"
      ],
      "summary": "Claim instrument",
      "title": "Claim"
    },
    {
      "actionOrder": [
        "create",
        "close"
      ],
      "actions": {
        "close": {
          "agentDescription": "Allocate this payment to outstanding debt once.",
          "allocate": {
            "amountField": "amount",
            "capture": "allocationReceipt",
            "mode": "payment",
            "paymentIdentityField": "paymentIdentity",
            "refField": "coverId",
            "sourceAccountField": "payer"
          },
          "effects": {
            "decides": [
              {
                "signature": "decides.allocation",
                "source": "allocate"
              }
            ],
            "moves": [
              {
                "signature": "moves.allocation",
                "source": "allocate"
              }
            ]
          },
          "moves": [],
          "publicAction": "closePayment",
          "steps": [],
          "summary": "Close instrument"
        },
        "create": {
          "agentDescription": "Record one payment identity.",
          "moves": [],
          "publicAction": "createPayment",
          "steps": [],
          "summary": "Create instrument"
        }
      },
      "agentDescription": "Allocate one identified payment through the obligation's bucket rules.",
      "fields": {
        "amount": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "coverId": {
          "pattern": "^cvr_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "currency": {
          "description": "ISO 4217 currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        "payer": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "paymentIdentity": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "id": "payment",
      "idPrefix": "pmt",
      "lifecycle": {
        "initial": "open",
        "states": [
          "open",
          "closed"
        ],
        "transitions": {
          "close": {
            "from": [
              "open"
            ],
            "to": "closed"
          }
        }
      },
      "required": [
        "coverId",
        "amount",
        "payer",
        "paymentIdentity",
        "currency"
      ],
      "summary": "Payment instrument",
      "title": "Payment"
    },
    {
      "actionOrder": [
        "create",
        "fund",
        "refund",
        "release"
      ],
      "actions": {
        "create": {
          "agentDescription": "Open the held account for these contributions.",
          "moves": [],
          "publicAction": "createJoinedSettlement",
          "steps": [
            {
              "bind": {
                "currency": {
                  "from": "const",
                  "value": "SAR"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                }
              },
              "capture": {
                "hold": "accountId"
              },
              "operation": "account.escrow.provision"
            }
          ],
          "summary": "Create instrument"
        },
        "fund": {
          "agentDescription": "Fund all contributions together.",
          "contributionStage": {
            "accountPath": "refs.hold",
            "stage": "fund"
          },
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "contributionStage"
              }
            ]
          },
          "moves": [],
          "publicAction": "fundJoinedSettlement",
          "steps": [],
          "summary": "Fund instrument"
        },
        "refund": {
          "agentDescription": "Refund all contributions to their original accounts.",
          "contributionStage": {
            "accountPath": "refs.hold",
            "stage": "refund"
          },
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "contributionStage"
              }
            ]
          },
          "moves": [],
          "publicAction": "refundJoinedSettlement",
          "steps": [],
          "summary": "Refund instrument"
        },
        "release": {
          "agentDescription": "Release the complete seller, fee and tax partition.",
          "effects": {
            "moves": [
              {
                "signature": "moves.transfer.internal",
                "source": "moves[0]"
              },
              {
                "signature": "moves.transfer.internal",
                "source": "moves[1]"
              },
              {
                "signature": "moves.transfer.internal",
                "source": "moves[2]"
              }
            ]
          },
          "moves": [
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.sellerNet"
                },
                "currency": {
                  "from": "const",
                  "value": "SAR"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.seller"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.hold"
                }
              },
              "key": "net",
              "operation": "internal_transfer.create"
            },
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.sellerFee"
                },
                "currency": {
                  "from": "const",
                  "value": "SAR"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.feeAccount"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.hold"
                }
              },
              "key": "fee",
              "operation": "internal_transfer.create"
            },
            {
              "bind": {
                "amount": {
                  "from": "instance",
                  "path": "fields.tax"
                },
                "currency": {
                  "from": "const",
                  "value": "SAR"
                },
                "destinationAccountId": {
                  "from": "instance",
                  "path": "fields.taxAccount"
                },
                "productId": {
                  "from": "instance",
                  "path": "productId"
                },
                "sourceAccountId": {
                  "from": "instance",
                  "path": "refs.hold"
                }
              },
              "key": "tax",
              "operation": "internal_transfer.create"
            }
          ],
          "publicAction": "releaseJoinedSettlement",
          "steps": [],
          "summary": "Release instrument"
        }
      },
      "agentDescription": "Fund one held balance from an immutable list and refund each origin.",
      "contributions": {
        "accountKey": "origin",
        "amountKey": "amount",
        "field": "contributions",
        "totalField": "price"
      },
      "fields": {
        "buyerPart": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "contributions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "amount": {
                "pattern": "^[1-9][0-9]{0,17}$",
                "type": "string",
                "x-hyperscale-currency": "SAR"
              },
              "origin": {
                "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
                "type": "string"
              }
            },
            "required": [
              "amount",
              "origin"
            ],
            "type": "object"
          },
          "maxItems": 256,
          "minItems": 1,
          "type": "array"
        },
        "currency": {
          "const": "SAR",
          "type": "string"
        },
        "feeAccount": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "funderPart": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "price": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "seller": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        },
        "sellerFee": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "sellerNet": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "tax": {
          "pattern": "^[1-9][0-9]{0,17}$",
          "type": "string",
          "x-hyperscale-currency": "SAR"
        },
        "taxAccount": {
          "pattern": "^acct_(sandbox|live)_[a-z0-9]{8,64}$",
          "type": "string"
        }
      },
      "id": "joined_settlement",
      "idPrefix": "stlm",
      "lifecycle": {
        "initial": "created",
        "states": [
          "created",
          "funded",
          "refunded",
          "released"
        ],
        "transitions": {
          "fund": {
            "from": [
              "created"
