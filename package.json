{
  "name": "@hyperscale0/udl",
  "version": "2.6.0",
  "description": "The Universal Domain Language: format spec, parser, validator, canonical serializer, and evolution diff.",
  "keywords": [
    "udl",
    "schema",
    "validator",
    "canonical-json",
    "json-schema",
    "conformance",
    "fintech"
  ],
  "homepage": "https://github.com/hyperscale0/hyperscale-udl#readme",
  "bugs": {
    "url": "https://github.com/hyperscale0/hyperscale-udl/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyperscale0/hyperscale-udl.git"
  },
  "license": "AGPL-3.0-only",
  "author": "Hyperscale LLC",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "udl": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./spec/*": "./spec/*",
    "./conformance/*": "./conformance/*",
    "./package.json": "./package.json"
  },
  "files": [
    "AUTHORS",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSING.md",
    "README.md",
    "SECURITY.md",
    "TRADEMARKS.md",
    "conformance",
    "docs",
    "dist",
    "skills",
    "spec",
    "src"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run docs:build && tsc -p tsconfig.build.json",
    "check": "bun run spec:check && bun run docs:build && bun test && tsc -p tsconfig.json && bun run build && bun scripts/check-bin.ts",
    "docs:build": "bun scripts/docs/build.ts",
    "postpack": "bun scripts/pack-exports.ts restore",
    "prepack": "bun run build && bun scripts/pack-exports.ts apply",
    "spec": "bun scripts/emit-spec.ts --write",
    "spec:check": "bun scripts/emit-spec.ts --check",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "typescript": "7.0.2"
  },
  "contributors": [
    "Meshael AlBakaawi",
    "Amir Ayub",
    "Sara AlBakaawi"
  ]
}
